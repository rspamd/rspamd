/*
 * Build identity: generated by CMake (cmake/BuildIdentity.cmake).
 * Kept apart from config.h so that it can change without a full rebuild.
 */
#ifndef RSPAMD_BUILD_ID_H
#define RSPAMD_BUILD_ID_H

/* Last release tag this tree descends from */
#define RSPAMD_RELEASE_BASE "${RSPAMD_RELEASE_BASE}"
/* 1 for a development build, 0 for an exact release */
#define RSPAMD_VERSION_DEV ${RSPAMD_VERSION_DEV_INT}
/*
 * RSPAMD_GIT_DESCRIBE is defined only when the describe data is known and
 * names the release base. RSPAMD_GIT_DISTANCE is defined together with it,
 * and also as 0 for a release build with no git information at all (a
 * tarball). Otherwise both are left undefined (a comment is emitted).
 */
${RSPAMD_BUILD_DESCRIBE_DEFINE}
${RSPAMD_BUILD_DISTANCE_DEFINE}

#endif
